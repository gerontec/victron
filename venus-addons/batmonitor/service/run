#!/bin/sh
exec 2>&1
# /data/batmonitor/env (every variable in it is exported):
#   BATMONITOR_LIVE=1          switches it live; without: dry run
#   BATMONITOR_LADESPERRE=0    switches the summer charge block off
#   BATMONITOR_PI=1            arms the PI prototype (else it only logs to /data/batmonitor/pi_shadow.csv)
#   BATMONITOR_<PARAM>=value   overrides a parameter of the C port, e.g. BATMONITOR_W_MAX=8000
#                              (list, defaults and limits: BM_PARAMS in c/bm_logic.c, logged at start as "params")
#   BATMONITOR_PYTHON=1        runs batmonitor.py (60 s) instead of the C port
set -a
[ -f /data/batmonitor/env ] && . /data/batmonitor/env
set +a
[ -x /data/batmonitor/c/batmonitor ] && [ "$BATMONITOR_PYTHON" != 1 ] && exec /data/batmonitor/c/batmonitor
exec python3 /data/batmonitor/batmonitor.py

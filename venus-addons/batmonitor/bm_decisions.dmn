<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="batmonitor" name="batmonitor decisions"
             namespace="https://github.com/gerontec/victron/batmonitor">
  <description>batmonitor decision tables (0.80-py). Standard DMN 1.3: opens in the Camunda Modeler / dmn-js. bm_logic.py reads this file at import (stdlib xml.etree, no engine on the Pi); tests/check_dmn.py checks it against the SpiffWorkflow DMN engine. Rules: hit policy FIRST (the first matching rule wins), the last rule of every table is all "-". Input entries: true / false / -. inputExpression: the meaning of the column, in the common subset of FEEL and Python (and, or, not(...), &lt; &lt;= &gt; &gt;=, + -), names = the chain inputs (bm_logic.DMN_INPUTS), BM_PARAMS (site value), number constants of bm_logic.py; a bare name = a flag the chain code supplies. Output entries: numbers, "KEEP" (the state stays) or the names BM_SRC_* / BM_WP_* / BM_M_*.</description>
  <decision id="D1_LATCH" name="D1_LATCH">
    <description>D1: Sofar first latch. Off at or below BAT1_SOC_MIN, on again from BAT1_SOC_MIN + 2 %.</description>
    <decisionTable id="D1_LATCH_table" hitPolicy="FIRST">
      <input id="D1_LATCH_in0" label="b1_above_min"><inputExpression id="D1_LATCH_ex0" typeRef="boolean"><text>have_soc_bat1 and soc_bat1 &gt; BAT1_SOC_MIN</text></inputExpression></input>
      <input id="D1_LATCH_in1" label="bat1_first"><inputExpression id="D1_LATCH_ex1" typeRef="boolean"><text>bat1_first</text></inputExpression></input>
      <input id="D1_LATCH_in2" label="b1_ge_release"><inputExpression id="D1_LATCH_ex2" typeRef="boolean"><text>soc_bat1 &gt;= BAT1_SOC_MIN + BAT1_FIRST_HYST</text></inputExpression></input>
      <output id="D1_LATCH_out0" name="bat1_first"/>
      <rule id="D1_LATCH_r1">
        <inputEntry id="D1_LATCH_r1_i0"><text>false</text></inputEntry>
        <inputEntry id="D1_LATCH_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_LATCH_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="D1_LATCH_r1_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D1_LATCH_r2">
        <inputEntry id="D1_LATCH_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_LATCH_r2_i1"><text>false</text></inputEntry>
        <inputEntry id="D1_LATCH_r2_i2"><text>true</text></inputEntry>
        <outputEntry id="D1_LATCH_r2_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D1_LATCH_r3">
        <inputEntry id="D1_LATCH_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_LATCH_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_LATCH_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="D1_LATCH_r3_o0"><text>"KEEP"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D1_B1_FIRST" name="D1_B1_FIRST">
    <description>D1: Sofar first acts only while the heat pump runs.</description>
    <decisionTable id="D1_B1_FIRST_table" hitPolicy="FIRST">
      <input id="D1_B1_FIRST_in0" label="bat1_first"><inputExpression id="D1_B1_FIRST_ex0" typeRef="boolean"><text>bat1_first</text></inputExpression></input>
      <input id="D1_B1_FIRST_in1" label="wp_on"><inputExpression id="D1_B1_FIRST_ex1" typeRef="boolean"><text>wp_fresh and wp &gt;= WP_ON_TH</text></inputExpression></input>
      <output id="D1_B1_FIRST_out0" name="b1_first"/>
      <rule id="D1_B1_FIRST_r1">
        <inputEntry id="D1_B1_FIRST_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_B1_FIRST_r1_i1"><text>true</text></inputEntry>
        <outputEntry id="D1_B1_FIRST_r1_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D1_B1_FIRST_r2">
        <inputEntry id="D1_B1_FIRST_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_B1_FIRST_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="D1_B1_FIRST_r2_o0"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D1_SRC" name="D1_SRC">
    <description>D1: S3 source of the discharge. DAY by day, B1 = Sofar first at night, WPG = winter night with the heat pump running (no night floor), STK = night floor.</description>
    <decisionTable id="D1_SRC_table" hitPolicy="FIRST">
      <input id="D1_SRC_in0" label="night"><inputExpression id="D1_SRC_ex0" typeRef="boolean"><text>have_pv and pv &lt; NIGHT_PV_TH</text></inputExpression></input>
      <input id="D1_SRC_in1" label="b1_first"><inputExpression id="D1_SRC_ex1" typeRef="boolean"><text>b1_first</text></inputExpression></input>
      <input id="D1_SRC_in2" label="winter"><inputExpression id="D1_SRC_ex2" typeRef="boolean"><text>winter</text></inputExpression></input>
      <input id="D1_SRC_in3" label="wp_on"><inputExpression id="D1_SRC_ex3" typeRef="boolean"><text>wp_fresh and wp &gt;= WP_ON_TH</text></inputExpression></input>
      <output id="D1_SRC_out0" name="src"/>
      <rule id="D1_SRC_r1">
        <inputEntry id="D1_SRC_r1_i0"><text>false</text></inputEntry>
        <inputEntry id="D1_SRC_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r1_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_SRC_r1_o0"><text>BM_SRC_DAY</text></outputEntry>
      </rule>
      <rule id="D1_SRC_r2">
        <inputEntry id="D1_SRC_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_SRC_r2_i1"><text>true</text></inputEntry>
        <inputEntry id="D1_SRC_r2_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r2_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_SRC_r2_o0"><text>BM_SRC_B1</text></outputEntry>
      </rule>
      <rule id="D1_SRC_r3">
        <inputEntry id="D1_SRC_r3_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_SRC_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r3_i2"><text>true</text></inputEntry>
        <inputEntry id="D1_SRC_r3_i3"><text>true</text></inputEntry>
        <outputEntry id="D1_SRC_r3_o0"><text>BM_SRC_WPG</text></outputEntry>
      </rule>
      <rule id="D1_SRC_r4">
        <inputEntry id="D1_SRC_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r4_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r4_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_SRC_r4_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_SRC_r4_o0"><text>BM_SRC_STK</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D1_WP_CAP" name="D1_WP_CAP">
    <description>D1: winter heat pump rule. Stacks give 0 W while the Sofar Bat1 discharges, else at most WP_WINTER_W.</description>
    <decisionTable id="D1_WP_CAP_table" hitPolicy="FIRST">
      <input id="D1_WP_CAP_in0" label="winter"><inputExpression id="D1_WP_CAP_ex0" typeRef="boolean"><text>winter</text></inputExpression></input>
      <input id="D1_WP_CAP_in1" label="wp_on"><inputExpression id="D1_WP_CAP_ex1" typeRef="boolean"><text>wp_fresh and wp &gt;= WP_ON_TH</text></inputExpression></input>
      <input id="D1_WP_CAP_in2" label="b1_dis"><inputExpression id="D1_WP_CAP_ex2" typeRef="boolean"><text>not(stale) and bat1 &lt; -B1_DIS_TH</text></inputExpression></input>
      <output id="D1_WP_CAP_out0" name="wp_cap"/>
      <rule id="D1_WP_CAP_r1">
        <inputEntry id="D1_WP_CAP_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r1_i1"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r1_i2"><text>true</text></inputEntry>
        <outputEntry id="D1_WP_CAP_r1_o0"><text>BM_WP_ZERO</text></outputEntry>
      </rule>
      <rule id="D1_WP_CAP_r2">
        <inputEntry id="D1_WP_CAP_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r2_i1"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r2_i2"><text>false</text></inputEntry>
        <outputEntry id="D1_WP_CAP_r2_o0"><text>BM_WP_MAX</text></outputEntry>
      </rule>
      <rule id="D1_WP_CAP_r3">
        <inputEntry id="D1_WP_CAP_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_CAP_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="D1_WP_CAP_r3_o0"><text>BM_WP_NONE</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D1_WP_PEAK" name="D1_WP_PEAK">
    <description>D1 heat pump peak (0.80-py, user 2026-11-08: "wenn wp = on und pcc kauft mehr als 5000W strom, dann akkus entladen, aber nur mit 1000W"): heat pump running and the grid import without the own discharge above WP_PEAK_ON_W -&gt; the stacks hold the import at WP_PEAK_ON_W ("besser statt fix 1000w pcc auf 5000w regeln"), at most WP_PEAK_W (any season, above the winter heat pump cap). Off below WP_PEAK_OFF_W or when the heat pump stops. PROT / LOW / FORCE still stop the discharge.</description>
    <decisionTable id="D1_WP_PEAK_table" hitPolicy="FIRST">
      <input id="D1_WP_PEAK_in0" label="wp_on"><inputExpression id="D1_WP_PEAK_ex0" typeRef="boolean"><text>wp_fresh and wp &gt;= WP_ON_TH</text></inputExpression></input>
      <input id="D1_WP_PEAK_in1" label="peak_on"><inputExpression id="D1_WP_PEAK_ex1" typeRef="boolean"><text>have_pcc and not(stale) and import_gross &gt; WP_PEAK_ON_W</text></inputExpression></input>
      <input id="D1_WP_PEAK_in2" label="peak_off"><inputExpression id="D1_WP_PEAK_ex2" typeRef="boolean"><text>not(have_pcc) or stale or import_gross &lt; WP_PEAK_OFF_W</text></inputExpression></input>
      <input id="D1_WP_PEAK_in3" label="wp_peak"><inputExpression id="D1_WP_PEAK_ex3" typeRef="boolean"><text>wp_peak</text></inputExpression></input>
      <output id="D1_WP_PEAK_out0" name="wp_peak"/>
      <rule id="D1_WP_PEAK_r1">
        <inputEntry id="D1_WP_PEAK_r1_i0"><text>false</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r1_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_WP_PEAK_r1_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D1_WP_PEAK_r2">
        <inputEntry id="D1_WP_PEAK_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r2_i2"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r2_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_WP_PEAK_r2_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D1_WP_PEAK_r3">
        <inputEntry id="D1_WP_PEAK_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r3_i1"><text>true</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r3_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r3_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_WP_PEAK_r3_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D1_WP_PEAK_r4">
        <inputEntry id="D1_WP_PEAK_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r4_i1"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r4_i2"><text>-</text></inputEntry>
        <inputEntry id="D1_WP_PEAK_r4_i3"><text>-</text></inputEntry>
        <outputEntry id="D1_WP_PEAK_r4_o0"><text>"KEEP"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D2_CHARGE_MODE" name="D2_CHARGE_MODE">
    <description>D2: charge mode on the surplus (&gt; 200 W), held down to 20 W once charging.</description>
    <decisionTable id="D2_CHARGE_MODE_table" hitPolicy="FIRST">
      <input id="D2_CHARGE_MODE_in0" label="surplus_gt_on"><inputExpression id="D2_CHARGE_MODE_ex0" typeRef="boolean"><text>surplus &gt; PCC_SURPLUS_TH</text></inputExpression></input>
      <input id="D2_CHARGE_MODE_in1" label="chg_prev"><inputExpression id="D2_CHARGE_MODE_ex1" typeRef="boolean"><text>chg_prev</text></inputExpression></input>
      <input id="D2_CHARGE_MODE_in2" label="surplus_gt_hold"><inputExpression id="D2_CHARGE_MODE_ex2" typeRef="boolean"><text>surplus &gt; SOYO_HOLD_TH</text></inputExpression></input>
      <output id="D2_CHARGE_MODE_out0" name="charge_mode"/>
      <rule id="D2_CHARGE_MODE_r1">
        <inputEntry id="D2_CHARGE_MODE_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="D2_CHARGE_MODE_r1_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_CHARGE_MODE_r2">
        <inputEntry id="D2_CHARGE_MODE_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r2_i1"><text>true</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r2_i2"><text>true</text></inputEntry>
        <outputEntry id="D2_CHARGE_MODE_r2_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_CHARGE_MODE_r3">
        <inputEntry id="D2_CHARGE_MODE_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_CHARGE_MODE_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="D2_CHARGE_MODE_r3_o0"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D2_PROT" name="D2_PROT">
    <description>D2: discharge protection (only while the BMS reports). On: SoC &lt; SOC_MIN, or (0.79-py, user 2026-11-08: the weakest cell decides in the critical range) the weakest cell of both stacks &lt; CELL_PROT_V while the SoC &lt; CELL_PROT_SOC. Off: SoC &gt;= SOC_MIN_RELEASE and the weakest cell &gt;= CELL_PROT_RELEASE_V (no cell value: SoC only).</description>
    <decisionTable id="D2_PROT_table" hitPolicy="FIRST">
      <input id="D2_PROT_in0" label="bms_ok"><inputExpression id="D2_PROT_ex0" typeRef="boolean"><text>bms_ok</text></inputExpression></input>
      <input id="D2_PROT_in1" label="soc_lt_min"><inputExpression id="D2_PROT_ex1" typeRef="boolean"><text>soc &lt; SOC_MIN</text></inputExpression></input>
      <input id="D2_PROT_in2" label="soc_ge_release"><inputExpression id="D2_PROT_ex2" typeRef="boolean"><text>soc &gt;= SOC_MIN_RELEASE</text></inputExpression></input>
      <input id="D2_PROT_in3" label="soc_lt_cell_zone"><inputExpression id="D2_PROT_ex3" typeRef="boolean"><text>soc &lt; CELL_PROT_SOC</text></inputExpression></input>
      <input id="D2_PROT_in4" label="cell_lt_prot"><inputExpression id="D2_PROT_ex4" typeRef="boolean"><text>cell_ok and cell_min &lt; CELL_PROT_V</text></inputExpression></input>
      <input id="D2_PROT_in5" label="cell_ge_prot_release"><inputExpression id="D2_PROT_ex5" typeRef="boolean"><text>not(cell_ok) or cell_min &gt;= CELL_PROT_RELEASE_V</text></inputExpression></input>
      <output id="D2_PROT_out0" name="prot"/>
      <rule id="D2_PROT_r1">
        <inputEntry id="D2_PROT_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r1_i1"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r1_i3"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r1_i4"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r1_i5"><text>-</text></inputEntry>
        <outputEntry id="D2_PROT_r1_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_PROT_r2">
        <inputEntry id="D2_PROT_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r2_i2"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r2_i3"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r2_i4"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r2_i5"><text>-</text></inputEntry>
        <outputEntry id="D2_PROT_r2_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_PROT_r3">
        <inputEntry id="D2_PROT_r3_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r3_i2"><text>true</text></inputEntry>
        <inputEntry id="D2_PROT_r3_i3"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r3_i4"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r3_i5"><text>true</text></inputEntry>
        <outputEntry id="D2_PROT_r3_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D2_PROT_r4">
        <inputEntry id="D2_PROT_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r4_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r4_i2"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r4_i3"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r4_i4"><text>-</text></inputEntry>
        <inputEntry id="D2_PROT_r4_i5"><text>-</text></inputEntry>
        <outputEntry id="D2_PROT_r4_o0"><text>"KEEP"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D2_FORCE" name="D2_FORCE">
    <description>D2: grid force charge, SOC_FORCE .. SOC_FORCE_RELEASE.</description>
    <decisionTable id="D2_FORCE_table" hitPolicy="FIRST">
      <input id="D2_FORCE_in0" label="bms_ok"><inputExpression id="D2_FORCE_ex0" typeRef="boolean"><text>bms_ok</text></inputExpression></input>
      <input id="D2_FORCE_in1" label="soc_lt_force"><inputExpression id="D2_FORCE_ex1" typeRef="boolean"><text>soc &lt; SOC_FORCE</text></inputExpression></input>
      <input id="D2_FORCE_in2" label="soc_ge_force_release"><inputExpression id="D2_FORCE_ex2" typeRef="boolean"><text>soc &gt;= SOC_FORCE_RELEASE</text></inputExpression></input>
      <output id="D2_FORCE_out0" name="force"/>
      <rule id="D2_FORCE_r1">
        <inputEntry id="D2_FORCE_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_FORCE_r1_i1"><text>true</text></inputEntry>
        <inputEntry id="D2_FORCE_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="D2_FORCE_r1_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_FORCE_r2">
        <inputEntry id="D2_FORCE_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_FORCE_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_FORCE_r2_i2"><text>true</text></inputEntry>
        <outputEntry id="D2_FORCE_r2_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D2_FORCE_r3">
        <inputEntry id="D2_FORCE_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D2_FORCE_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_FORCE_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="D2_FORCE_r3_o0"><text>"KEEP"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D2_LOW" name="D2_LOW">
    <description>D2: LOW force charge: DCL 0 or lowest cell &lt; CELL_FORCE_V; ends once DCL is back, the cell &gt;= CELL_FORCE_RELEASE_V and the SoC &gt;= SOC_MIN_RELEASE.</description>
    <decisionTable id="D2_LOW_table" hitPolicy="FIRST">
      <input id="D2_LOW_in0" label="bms_ok"><inputExpression id="D2_LOW_ex0" typeRef="boolean"><text>bms_ok</text></inputExpression></input>
      <input id="D2_LOW_in1" label="low_on"><inputExpression id="D2_LOW_ex1" typeRef="boolean"><text>(lim_ok and dcl &lt; DCL_FORCE_A) or (cell_ok and cell_min &lt; CELL_FORCE_V)</text></inputExpression></input>
      <input id="D2_LOW_in2" label="low_off"><inputExpression id="D2_LOW_ex2" typeRef="boolean"><text>not(lim_ok and dcl &lt; DCL_FORCE_A) and (not(cell_ok) or cell_min &gt;= CELL_FORCE_RELEASE_V)</text></inputExpression></input>
      <input id="D2_LOW_in3" label="soc_ge_release"><inputExpression id="D2_LOW_ex3" typeRef="boolean"><text>soc &gt;= SOC_MIN_RELEASE</text></inputExpression></input>
      <output id="D2_LOW_out0" name="low"/>
      <rule id="D2_LOW_r1">
        <inputEntry id="D2_LOW_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_LOW_r1_i1"><text>true</text></inputEntry>
        <inputEntry id="D2_LOW_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D2_LOW_r1_i3"><text>-</text></inputEntry>
        <outputEntry id="D2_LOW_r1_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D2_LOW_r2">
        <inputEntry id="D2_LOW_r2_i0"><text>true</text></inputEntry>
        <inputEntry id="D2_LOW_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="D2_LOW_r2_i2"><text>true</text></inputEntry>
        <inputEntry id="D2_LOW_r2_i3"><text>true</text></inputEntry>
        <outputEntry id="D2_LOW_r2_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D2_LOW_r3">
        <inputEntry id="D2_LOW_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D2_LOW_r3_i1"><text>-</text></inputEntry>

  <decision id="D3" name="D3">
    <description>D3: PROPORTIONAL (1) while importing, or (already proportional / night floor) while the deficit &gt; 20 W.</description>
    <decisionTable id="D3_table" hitPolicy="FIRST">
      <input id="D3_in0" label="any_dis"><inputExpression id="D3_ex0" typeRef="boolean"><text>any_dis</text></inputExpression></input>

  <decision id="D4_PEAK" name="D4_PEAK">
    <description>D4: PCC above 20 kW seen today (display).</description>
    <decisionTable id="D4_PEAK_table" hitPolicy="FIRST">
      <input id="D4_PEAK_in0" label="pcc_peak"><inputExpression id="D4_PEAK_ex0" typeRef="boolean"><text>have_pcc and not(stale) and pcc &gt; PCC_PEAK_TH</text></inputExpression></input>

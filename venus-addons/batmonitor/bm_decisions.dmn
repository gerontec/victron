        <inputEntry id="D4_r6_i4"><text>-</text></inputEntry>
        <inputEntry id="D4_r6_i5"><text>-</text></inputEntry>
        <outputEntry id="D4_r6_o0"><text>1</text></outputEntry>
        <outputEntry id="D4_r6_o1"><text>1</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D5" name="D5">
    <description>D5: DO4 pulse (FoxESS shedding): PCC &gt; 20 kW for the grace time or &gt; DO4_HARD_W, or grid offline and PV overfeeds one AC-out; never twice within the lockout.</description>
    <decisionTable id="D5_table" hitPolicy="FIRST">
      <input id="D5_in0" label="lockout_over"><inputExpression id="D5_ex0" typeRef="boolean"><text>lockout_over</text></inputExpression></input>
      <input id="D5_in1" label="acout_over"><inputExpression id="D5_ex1" typeRef="boolean"><text>acout_over</text></inputExpression></input>
      <input id="D5_in2" label="pcc_over"><inputExpression id="D5_ex2" typeRef="boolean"><text>pcc_over</text></inputExpression></input>
      <input id="D5_in3" label="grace_over"><inputExpression id="D5_ex3" typeRef="boolean"><text>grace_over</text></inputExpression></input>
      <input id="D5_in4" label="pcc_hard"><inputExpression id="D5_ex4" typeRef="boolean"><text>pcc_hard</text></inputExpression></input>
      <output id="D5_out0" name="do4"/>
      <rule id="D5_r1">
        <inputEntry id="D5_r1_i0"><text>false</text></inputEntry>
        <inputEntry id="D5_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D5_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D5_r1_i3"><text>-</text></inputEntry>
        <inputEntry id="D5_r1_i4"><text>-</text></inputEntry>
        <outputEntry id="D5_r1_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="D5_r2">
        <inputEntry id="D5_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="D5_r2_i1"><text>true</text></inputEntry>
        <inputEntry id="D5_r2_i2"><text>-</text></inputEntry>
        <inputEntry id="D5_r2_i3"><text>-</text></inputEntry>
        <inputEntry id="D5_r2_i4"><text>-</text></inputEntry>
        <outputEntry id="D5_r2_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D5_r3">
        <inputEntry id="D5_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D5_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D5_r3_i2"><text>true</text></inputEntry>
        <inputEntry id="D5_r3_i3"><text>true</text></inputEntry>
        <inputEntry id="D5_r3_i4"><text>-</text></inputEntry>
        <outputEntry id="D5_r3_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D5_r4">
        <inputEntry id="D5_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="D5_r4_i1"><text>-</text></inputEntry>
        <inputEntry id="D5_r4_i2"><text>true</text></inputEntry>
        <inputEntry id="D5_r4_i3"><text>-</text></inputEntry>
        <inputEntry id="D5_r4_i4"><text>true</text></inputEntry>
        <outputEntry id="D5_r4_o0"><text>1</text></outputEntry>
      </rule>
      <rule id="D5_r5">
        <inputEntry id="D5_r5_i0"><text>-</text></inputEntry>
        <inputEntry id="D5_r5_i1"><text>-</text></inputEntry>
        <inputEntry id="D5_r5_i2"><text>-</text></inputEntry>
        <inputEntry id="D5_r5_i3"><text>-</text></inputEntry>
        <inputEntry id="D5_r5_i4"><text>-</text></inputEntry>
        <outputEntry id="D5_r5_o0"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="D7" name="D7">
    <description>D7: house on AC-out1. HOUSE_ACOUT 0 = off, 1 = on, auto: on after 60 s above 200 W, off after 120 s below 100 W.</description>
    <decisionTable id="D7_table" hitPolicy="FIRST">
      <input id="D7_in0" label="mode_off"><inputExpression id="D7_ex0" typeRef="boolean"><text>mode_off</text></inputExpression></input>
      <input id="D7_in1" label="mode_on"><inputExpression id="D7_ex1" typeRef="boolean"><text>mode_on</text></inputExpression></input>
      <input id="D7_in2" label="over_on"><inputExpression id="D7_ex2" typeRef="boolean"><text>acout_total &gt; HOUSE_ON_W</text></inputExpression></input>
      <input id="D7_in3" label="over_long"><inputExpression id="D7_ex3" typeRef="boolean"><text>over_long</text></inputExpression></input>
      <input id="D7_in4" label="under_off"><inputExpression id="D7_ex4" typeRef="boolean"><text>acout_total &lt; HOUSE_OFF_W</text></inputExpression></input>
      <input id="D7_in5" label="under_long"><inputExpression id="D7_ex5" typeRef="boolean"><text>under_long</text></inputExpression></input>
      <input id="D7_in6" label="on"><inputExpression id="D7_ex6" typeRef="boolean"><text>on</text></inputExpression></input>
      <output id="D7_out0" name="on"/>
      <output id="D7_out1" name="under"/>
      <output id="D7_out2" name="over"/>
      <rule id="D7_r1">
        <inputEntry id="D7_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="D7_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r1_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r1_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r1_i4"><text>-</text></inputEntry>
        <inputEntry id="D7_r1_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r1_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r1_o0"><text>0</text></outputEntry>
        <outputEntry id="D7_r1_o1"><text>0</text></outputEntry>
        <outputEntry id="D7_r1_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="D7_r2">
        <inputEntry id="D7_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r2_i1"><text>true</text></inputEntry>
        <inputEntry id="D7_r2_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r2_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r2_i4"><text>-</text></inputEntry>
        <inputEntry id="D7_r2_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r2_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r2_o0"><text>1</text></outputEntry>
        <outputEntry id="D7_r2_o1"><text>0</text></outputEntry>
        <outputEntry id="D7_r2_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="D7_r3">
        <inputEntry id="D7_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r3_i2"><text>true</text></inputEntry>
        <inputEntry id="D7_r3_i3"><text>true</text></inputEntry>
        <inputEntry id="D7_r3_i4"><text>-</text></inputEntry>
        <inputEntry id="D7_r3_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r3_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r3_o0"><text>1</text></outputEntry>
        <outputEntry id="D7_r3_o1"><text>0</text></outputEntry>
        <outputEntry id="D7_r3_o2"><text>1</text></outputEntry>
      </rule>
      <rule id="D7_r4">
        <inputEntry id="D7_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r4_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r4_i2"><text>true</text></inputEntry>
        <inputEntry id="D7_r4_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r4_i4"><text>-</text></inputEntry>
        <inputEntry id="D7_r4_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r4_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r4_o0"><text>"KEEP"</text></outputEntry>
        <outputEntry id="D7_r4_o1"><text>0</text></outputEntry>
        <outputEntry id="D7_r4_o2"><text>1</text></outputEntry>
      </rule>
      <rule id="D7_r5">
        <inputEntry id="D7_r5_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r5_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r5_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r5_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r5_i4"><text>true</text></inputEntry>
        <inputEntry id="D7_r5_i5"><text>true</text></inputEntry>
        <inputEntry id="D7_r5_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r5_o0"><text>0</text></outputEntry>
        <outputEntry id="D7_r5_o1"><text>1</text></outputEntry>
        <outputEntry id="D7_r5_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="D7_r6">
        <inputEntry id="D7_r6_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r6_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r6_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r6_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r6_i4"><text>true</text></inputEntry>
        <inputEntry id="D7_r6_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r6_i6"><text>true</text></inputEntry>
        <outputEntry id="D7_r6_o0"><text>1</text></outputEntry>
        <outputEntry id="D7_r6_o1"><text>1</text></outputEntry>
        <outputEntry id="D7_r6_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="D7_r7">
        <inputEntry id="D7_r7_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r7_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r7_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r7_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r7_i4"><text>true</text></inputEntry>
        <inputEntry id="D7_r7_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r7_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r7_o0"><text>0</text></outputEntry>
        <outputEntry id="D7_r7_o1"><text>1</text></outputEntry>
        <outputEntry id="D7_r7_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="D7_r8">
        <inputEntry id="D7_r8_i0"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i1"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i2"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i3"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i4"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i5"><text>-</text></inputEntry>
        <inputEntry id="D7_r8_i6"><text>-</text></inputEntry>
        <outputEntry id="D7_r8_o0"><text>"KEEP"</text></outputEntry>

			D4_r3 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>block = 0, cap = 1</b>>];
			D4_q3 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<surplus_cap_on?>];
			D4_q2 -> D4_q3 [label=" no"];
			D4_q3 -> D4_r3 [label=" yes", color="#3c7a30"];
			D4_r4 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>block = 0, cap = 1</b>>];
			D4_q4 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<chg_prev and<br/>surplus_cap_hold?>];
			D4_q3 -> D4_q4 [label=" no"];
			D4_q4 -> D4_r4 [label=" yes", color="#3c7a30"];
			D4_r5 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>block = 1, cap = 1</b>>];
			D4_q4 -> D4_r5 [label=" otherwise"];
		}
	}
	subgraph cluster_g_D5 {
		label=<<b>D5 DO4 pulse</b>>; style="rounded,filled"; fillcolor="#f7f9fc"; color="#4a7fb5";
		subgraph cluster_t_D5 {
			label=<<b>D5</b> -&gt; do4>; style="rounded"; color="#9fb7d4";
			D5_in [shape=point, width=0.08];
			D5_r0 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>do4 = 0</b>>];
			D5_q0 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<not lockout_over?>];
			D5_in -> D5_q0;
			D5_q0 -> D5_r0 [label=" yes", color="#3c7a30"];
			D5_r1 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>do4 = 1</b>>];
			D5_q1 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<acout_over?>];
			D5_q0 -> D5_q1 [label=" no"];
			D5_q1 -> D5_r1 [label=" yes", color="#3c7a30"];
			D5_r2 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>do4 = 1</b>>];
			D5_q2 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<pcc_over and grace_over?>];
			D5_q1 -> D5_q2 [label=" no"];
			D5_q2 -> D5_r2 [label=" yes", color="#3c7a30"];
			D5_r3 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>do4 = 1</b>>];
			D5_q3 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<pcc_over and pcc_hard?>];
			D5_q2 -> D5_q3 [label=" no"];
			D5_q3 -> D5_r3 [label=" yes", color="#3c7a30"];
			D5_r4 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>do4 = 0</b>>];
			D5_q3 -> D5_r4 [label=" otherwise"];
		}
	}
	subgraph cluster_g_D7 {
		label=<<b>D7 house on AC-out1</b>>; style="rounded,filled"; fillcolor="#f7f9fc"; color="#4a7fb5";
		subgraph cluster_t_D7 {
			label=<<b>D7</b> -&gt; on, under>; style="rounded"; color="#9fb7d4";
			D7_in [shape=point, width=0.08];
			D7_r0 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 0, under = 0</b>>];
			D7_q0 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<mode_off?>];
			D7_in -> D7_q0;
			D7_q0 -> D7_r0 [label=" yes", color="#3c7a30"];
			D7_r1 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 1, under = 0</b>>];
			D7_q1 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<mode_on?>];
			D7_q0 -> D7_q1 [label=" no"];
			D7_q1 -> D7_r1 [label=" yes", color="#3c7a30"];
			D7_r2 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 1, under = 0</b>>];
			D7_q2 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<over_on?>];
			D7_q1 -> D7_q2 [label=" no"];
			D7_q2 -> D7_r2 [label=" yes", color="#3c7a30"];
			D7_r3 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 0, under = 1</b>>];
			D7_q3 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<under_off and under_long?>];
			D7_q2 -> D7_q3 [label=" no"];
			D7_q3 -> D7_r3 [label=" yes", color="#3c7a30"];
			D7_r4 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 1, under = 1</b>>];
			D7_q4 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<under_off and on?>];
			D7_q3 -> D7_q4 [label=" no"];
			D7_q4 -> D7_r4 [label=" yes", color="#3c7a30"];
			D7_r5 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = 0, under = 1</b>>];
			D7_q5 [shape=diamond, style=filled, fillcolor="#dbe8fb", margin=0.02, label=<under_off?>];
			D7_q4 -> D7_q5 [label=" no"];
			D7_q5 -> D7_r5 [label=" yes", color="#3c7a30"];
			D7_r6 [shape=box, style="rounded,filled", fillcolor="#e8e8e8", label=<<b>on = KEEP, under = 0</b>>];
			D7_q5 -> D7_r6 [label=" otherwise"];
		}
	}
	D1_LATCH_r0 -> D1_B1_FIRST_in [ltail=cluster_t_D1_LATCH, lhead=cluster_t_D1_B1_FIRST, color="#4a7fb5", style=dashed, label=" bat1_first", constraint=false];
	D1_B1_FIRST_r0 -> D1_SRC_in [ltail=cluster_t_D1_B1_FIRST, lhead=cluster_t_D1_SRC, color="#4a7fb5", style=dashed, label=" b1_first", constraint=false];
	D2_CHARGE_MODE_r0 -> D2_MODE_in [ltail=cluster_t_D2_CHARGE_MODE, lhead=cluster_t_D2_MODE, color="#4a7fb5", style=dashed, label=" charge_mode", constraint=false];
	D2_PROT_r0 -> D2_MODE_in [ltail=cluster_t_D2_PROT, lhead=cluster_t_D2_MODE, color="#4a7fb5", style=dashed, label=" prot", constraint=false];
	D2_FORCE_r0 -> D2_MODE_in [ltail=cluster_t_D2_FORCE, lhead=cluster_t_D2_MODE, color="#4a7fb5", style=dashed, label=" force", constraint=false];
	D2_LOW_r0 -> D2_MODE_in [ltail=cluster_t_D2_LOW, lhead=cluster_t_D2_MODE, color="#4a7fb5", style=dashed, label=" low", constraint=false];

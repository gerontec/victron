// batmonitor 0.48-c: overview of one cycle - a common trunk, then one charge path and one discharge branch.
// Details: charge_flow.pdf (charge path, peak window) and decision_flow.pdf (discharge matrix, CBMC coverage).
// render: dot -Tpdf control_flow.dot -o control_flow.pdf   (or -Tpng)
digraph control {
	graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.4, newrank=true,
		   label="batmonitor 0.48-c: one cycle every 5 s   |   blue = decision (bits + state, make check)   |   green = matrix / amount   |   details: charge_flow.pdf, decision_flow.pdf",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b> (bm_parse: only valid numbers, else stale)<br/>PCC, Sofar Bat1, PV, heat pump W, R290 Hz, BMS SoC / U / CCL / DCL, season, forecast>, fillcolor="#ffffff"];
	d1 [label=<<b>D1</b> forecast, B1FIRST<br/>-&gt; S2 heat pump part (z2 = PCC + WP not covered)<br/>-&gt; S3 source DAY / B1 / STK / B1W>, fillcolor="#dbe8fb"];
	gates [label=<<b>S0 caps</b> per stack: chg_cap, dis_cap (charger, BMS CCL / DCL)>];
	d2 [label=<<b>D2 mode</b> per stack, first match:<br/>BMS_MISSING &gt; FORCE &gt; STALE &gt; LADESPERRE &gt; CHARGE / FULL &gt; PROT &gt; CHARGING &gt; DIS>, fillcolor="#dbe8fb"];
	lead [label=<<b>D-lead</b>: stack more than SOC_BALANCE_ON ahead>, fillcolor="#dbe8fb"];
	mode [label=<<b>mode matrix</b> BM_MODE_RULE<br/>0 W | FORCE | charge | discharge>, fillcolor="#eaf6e6", shape=box];

	subgraph cluster_charge {
		label=<<b>charge path</b>>; style="rounded,filled"; fillcolor="#eef4fb"; color="#4a7fb5"; fontsize=12;
		d4 [label=<<b>D4 LADESPERRE</b> (May-Aug)<br/>stacks stay free until the PCC peak>, fillcolor="#dbe8fb"];
		cforce [label=<<b>FORCE</b>: min(500 W, chg_cap)>, fillcolor="#eaf6e6"];
		camount [label=<<b>charge amount</b><br/>max(0, own + KP x (z2 + Bat1_eff - target))<br/>&le; sum of chg_cap>, fillcolor="#eaf6e6"];
		csplit [label=<<b>alloc_levels</b> up to chg_cap<br/>stack by stack in CHARGE_PRIORITY,<br/>lead stack last>, fillcolor="#eaf6e6"];
		camount -> csplit;
	}

	subgraph cluster_dis {
		label=<<b>discharge branch</b>>; style="rounded,filled"; fillcolor="#eef7ec"; color="#5a9e4b"; fontsize=12;
		src [label=<<b>BM_SRC_RULE[src]</b><br/>STK: Bat1 signed, +trickle, idle 0<br/>else: Bat1 charge only, idle 20 W>, fillcolor="#eaf6e6"];
		d3 [label=<<b>D3</b> PROP / IDLE>, fillcolor="#dbe8fb"];
		damount [label=<<b>discharge amount</b><br/>min(PROP ? deficit : idle, W_MAX, WP_CAP)>, fillcolor="#eaf6e6"];
		dsplit [label=<<b>alloc_levels</b> up to dis_cap<br/>lead stack first, else<br/>every stack the same share>, fillcolor="#eaf6e6"];
		src -> d3 -> damount -> dsplit;
	}

	d5 [label=<<b>D5</b> PCC &gt; 20 kW -&gt; DO4 pulse<br/>pv_relay/DO4 (FoxESS shedding)>, fillcolor="#ffd09a"];
	out [label=<<b>setpoints</b> per phase -&gt; Multis (+ charge / - discharge)<br/>rule text: mode WP: SRC: split [CCL / DCL / WPCAP]>, fillcolor="#ffffff"];

	in -> d1 -> d2;
	in -> gates;
	gates -> d2 [style=dashed, label=" SoC"];
	d2 -> lead -> mode;
	mode -> cforce [label=" FORCE"];
	mode -> camount [label=" CHARGE"];
	mode -> src [label=" DIS"];
	mode -> out [label=" 0 W rows", style=dashed];
	d4 -> d2 [color="#d9822b", label=" block"];
	in -> d4 [style=dashed];
	in -> d5 [style=dashed, color="#d9822b"];
	d1 -> src [style=dashed, label=" src, z2"];
	cforce -> out;
	csplit -> out;
	dsplit -> out;
}

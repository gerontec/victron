// batmonitor 0.74 (C 0.74-c, Python 0.74-py live since 2026-11-04): overview of one cycle - a common trunk, then one
// charge path and one discharge branch. Details: charge_flow, discharge_flow, wp_matrix; the decision tables
// themselves: decision_tables / decision_flow (generated from c/bm_tables.h by gen_docs.py).
// render: python3 docs/gen_docs.py   (renders every docs/*.dot to .pdf and .png)
digraph control {
	graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.4, newrank=true,
		   label="batmonitor 0.74: one cycle every 5 s   |   max persistent decision states 12288   |   blue = decision (c/bm_tables.h, make check)   |   green = matrix / amount   |   details: charge_flow, discharge_flow, decision_tables",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b> (bm_parse: only valid numbers, else stale)<br/>PCC (live, sofar_fast 4 s), Sofar Bat1 W + SoC, PV, heat pump W, R290 Hz,<br/>BMS SoC / U / CCL / DCL / lowest + highest cell, AC-in / AC-out per phase, grid connected>, fillcolor="#ffffff"];
	d7 [label=<<b>D7</b> house on AC-out1 (0.69-c)<br/>HOUSE_ACOUT 0 off / 1 on / 2 auto (&gt; 99 W on, 60 s &lt; 30 W off)<br/>on: winter Z2 near 0 (discharge = AC-out1 load), summer Z1 near 0<br/><font point-size="9">Lenggries env: HOUSE_ACOUT=0</font>>, fillcolor="#dbe8fb"];
	d1 [label=<<b>D1</b> Sofar first, S3 source DAY / B1 / STK / WPG<br/>winter heat pump rule (0.61-c): Bat1 discharging -&gt; 0 W, else WP_WINTER_W<br/><font point-size="9">make check: 128 cells, 14 outcomes; details wp_matrix</font>>, fillcolor="#dbe8fb"];
	gates [label=<<b>S0 caps</b> per phase: chg_cap, dis_cap (charger, BMS CCL / DCL)<br/><b>top hold</b> (0.73-c, TOP_HOLD_STACK): charge cap so the highest cell stays at TOP_HOLD_CELL_V>];
	d2 [label=<<b>D2 mode</b> per stack, first match:<br/>BMS_MISSING &gt; FORCE &gt; STALE &gt; LADESPERRE &gt; CHARGE / FULL &gt; HOLD &gt; PROT &gt; CHARGING &gt; DIS<br/>FORCE = SoC &lt; SOC_FORCE or LOW (DCL 0 / cell &lt; CELL_FORCE_V; ends at SOC_MIN_RELEASE)<br/>CHARGE also at 100 % for force_full (FF) and the top hold window (TOP); HOLD = force_full without surplus<br/><font point-size="9">make check: 64512 combinations per stack -&gt; BMS_MISSING 32256 · FORCE 23040 · STALE 4608 ·<br/>LADESPERRE 1152 · HOLD 1152 · CHARGE 1080 · PROT 432 · CHARGING 360 · DIS 360 · FULL 72</font>>, fillcolor="#dbe8fb"];
	lead [label=<<b>D-lead</b>: stack more than SOC_BALANCE_ON ahead>, fillcolor="#dbe8fb"];
	mode [label=<<b>mode matrix</b> BM_MODE_RULE<br/>0 W | FORCE | charge | discharge>, fillcolor="#eaf6e6", shape=box];

	subgraph cluster_charge {
		label=<<b>charge path</b>>; style="rounded,filled"; fillcolor="#eef4fb"; color="#4a7fb5"; fontsize=12;
		d4 [label=<<b>D4 forecast export cap</b> (May-Aug)<br/>while the forecast expects export &gt; 18 kW:<br/>wait below the cap, charge only above it>, fillcolor="#dbe8fb"];
		cforce [label=<<b>FORCE</b>: min(500 W, chg_cap)<br/>any time of day, no TOU window>, fillcolor="#eaf6e6"];
		camount [label=<<b>charge amount</b><br/>max(0, own + KP x (PCC + Bat1_eff - target))<br/>target = CHARGE_RESERVE (+ EXPORT_CAP while D4 cap);<br/>&le; sum of chg_cap>, fillcolor="#eaf6e6"];
		csplit [label=<<b>alloc_levels</b> up to chg_cap<br/>stack by stack in CHARGE_PRIORITY,<br/>force_full stack first, else the lead stack last>, fillcolor="#eaf6e6"];
		camount -> csplit;
	}

	subgraph cluster_dis {
		label=<<b>discharge branch</b>>; style="rounded,filled"; fillcolor="#eef7ec"; color="#5a9e4b"; fontsize=12;
		src [label=<<b>BM_SRC_RULE[src]</b><br/>STK: Bat1 signed, +trickle, idle 0<br/>else: Bat1 charge only, idle 20 W>, fillcolor="#eaf6e6"];
		d3 [label=<<b>D3</b> PROP / IDLE<br/>(D7 on: HOUSE / PROP / EXPCAP instead)>, fillcolor="#dbe8fb"];
		damount [label=<<b>discharge amount</b><br/>min(PROP ? deficit : idle, dis_max)<br/>dis_max = W_MAX or the winter heat pump cap (WPMAX)<br/>D7 winter: at most what keeps the export at CHARGE_RESERVE (EXPCAP, 0.74-c)>, fillcolor="#eaf6e6"];
		dsplit [label=<<b>alloc_levels</b> up to dis_cap, all discharging phases<br/>lead stack first (BAL, SPILL / WAIT), else the same share (EQ)<br/><font point-size="9">single-unit discharge (D6, 1PH) removed in 0.70-c</font>>, fillcolor="#eaf6e6"];
		src -> d3 -> damount -> dsplit;
	}

	d5 [label=<<b>D5</b> PCC &gt; 20 kW for 2 min (at once &gt; 23 kW) -&gt; DO4 pulse<br/>pv_relay/DO4 (FoxESS shedding)<br/>first: R290 boost + air conditioning at &ge; 18 kW<br/>grid offline: AC-out feed &gt; 5 kW / unit for 10 s -&gt; at once>, fillcolor="#ffd09a"];
	out [label=<<b>setpoints</b> per phase -&gt; Multis (+ charge / - discharge)<br/>rule text: mode SRC: split [CAP] [TOP] [WPMAX(W)] [LOW] [CCL / DCL / CELL]<br/>-&gt; state.json -&gt; victron2db.py (cron 1/min) -&gt; wagodb.pv_victron.bm_l1..3_rule>, fillcolor="#ffffff"];

	in -> d7 -> d1 -> d2;
	in -> gates;
	gates -> d2 [style=dashed, label=" SoC, caps"];
	d2 -> lead -> mode;
	mode -> cforce [label=" FORCE"];
	mode -> camount [label=" CHARGE"];
	mode -> src [label=" DIS"];
	mode -> out [label=" 0 W rows", style=dashed];
	d4 -> d2 [color="#d9822b", label=" block"];
	in -> d4 [style=dashed];
	in -> d5 [style=dashed, color="#d9822b"];
	d1 -> src [style=dashed, label=" src, WPMAX"];
	cforce -> out;
	csplit -> out;
	dsplit -> out;
}

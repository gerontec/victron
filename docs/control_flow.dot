// batmonitor 0.56-c: overview of one cycle - a common trunk, then one charge path and one discharge branch.
// Details: charge_flow.pdf (charge path, peak window) and discharge_flow.pdf (discharge matrix, CBMC coverage).
// render: dot -Tpdf control_flow.dot -o control_flow.pdf   (or -Tpng)
digraph control {
	graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.4, newrank=true,
		   label="batmonitor 0.56-c: one cycle every 5 s   |   blue = decision (bits + state, make check)   |   green = matrix / amount   |   details: charge_flow.pdf, discharge_flow.pdf",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b> (bm_parse: only valid numbers, else stale)<br/>PCC, Sofar Bat1, PV, heat pump W, R290 Hz, BMS SoC / U / CCL / DCL / lowest cell, season, forecast>, fillcolor="#ffffff"];
	d1 [label=<<b>D1</b> forecast, B1FIRST, WP_LOW (0.54-c)<br/>-&gt; S2 heat pump kind NONE / CAP / ALL / BAD (z2 = PCC + WP not covered)<br/>-&gt; S3 source DAY / B1 / STK / B1W<br/><font point-size="9">make check: 442368 combinations (16 bits x 3 seasons x 8 states)</font>>, fillcolor="#dbe8fb"];
	wpm [shape=plain, label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td colspan="6"><b>heat pump matrix</b> (S2 kind from D1, + D6 WPPV): who pays the heat pump</td></tr>
			<tr><td><b>WP reason</b></td><td><b>when</b></td><td><b>S2 kind</b></td><td><b>discharge: stacks cover</b></td><td><b>charge point z2 / chg_ref</b></td><td><b>grid buys</b></td></tr>
			<tr><td>OFF / NA</td><td>WP &lt; 300 W / em0 stale</td><td>-</td><td>house only (NA + winter: WP_CAP 1 kW)</td><td>PCC</td><td>-</td></tr>
			<tr><td>LOWSOC</td><td>lowest stack &lt; WP_SOC_MIN 21 % (back &ge; 23 %)</td><td>NONE</td><td>0 W of the WP</td><td>PCC + WP</td><td>all of the WP</td></tr>
			<tr><td>Z2</td><td>winter</td><td>NONE</td><td>0 W of the WP</td><td>PCC + WP</td><td>all of the WP</td></tr>
			<tr><td>T1900 / ALL</td><td>transition</td><td>CAP</td><td>up to 1900 W</td><td>PCC + (WP - 1900)</td><td>WP above 1900 W</td></tr>
			<tr><td>FCBAD</td><td>bad forecast (target_soc 100)</td><td>BAD</td><td>50 % of the WP</td><td>PCC + 50 % WP</td><td>50 % of the WP</td></tr>
			<tr><td>FC / ALL</td><td>good forecast / summer</td><td>ALL</td><td>all of the WP</td><td>PCC</td><td>-</td></tr>
			<tr><td bgcolor="#fde9c8"><b>... + WPPV</b> (0.56-c)</td><td bgcolor="#fde9c8">kind ALL, day, WP on, PV covers house + WP,<br/>no D4 cap</td><td bgcolor="#fde9c8">ALL</td><td bgcolor="#fde9c8">(charging, no discharge)</td><td bgcolor="#fde9c8">PCC + min(50 % WP, 2000 W)</td><td bgcolor="#fde9c8">min(50 % WP, 2 kW)<br/>into the stacks</td></tr>
			</table>>];
	gates [label=<<b>S0 caps</b> per stack: chg_cap, dis_cap (charger, BMS CCL / DCL)>];
	d2 [label=<<b>D2 mode</b> per stack, first match:<br/>BMS_MISSING &gt; FORCE &gt; STALE &gt; LADESPERRE &gt; CHARGE / FULL &gt; PROT &gt; CHARGING &gt; DIS<br/>FORCE = SoC &lt; SOC_FORCE or LOW (DCL 0 / cell &lt; 3.05 V; ends at SOC_MIN_RELEASE, 0.55-c)<br/><font point-size="9">make check: 16128 combinations per stack (84 bit sets x 12 global x 16 states) -&gt; mode:<br/>BMS_MISSING 8064 · FORCE 5760 · STALE 1152 · LADESPERRE 288 · CHARGE 216 ·<br/>PROT 216 · CHARGING 180 · DIS 180 · FULL 72</font>>, fillcolor="#dbe8fb"];
	lead [label=<<b>D-lead</b>: stack more than SOC_BALANCE_ON ahead>, fillcolor="#dbe8fb"];
	mode [label=<<b>mode matrix</b> BM_MODE_RULE<br/>0 W | FORCE | charge | discharge>, fillcolor="#eaf6e6", shape=box];

	subgraph cluster_charge {
		label=<<b>charge path</b>>; style="rounded,filled"; fillcolor="#eef4fb"; color="#4a7fb5"; fontsize=12;
		d4 [label=<<b>D4 forecast export cap</b> (May-Aug)<br/>while the forecast expects export &gt; 18 kW:<br/>wait below the cap, charge only above it>, fillcolor="#dbe8fb"];
		d6 [label=<<b>D6 WPPV</b> (0.56-c)<br/>WP on PV, kind ALL, day, no D4 cap:<br/>chg_ref += min(WP_PV_CHG_SHARE 50 % x WP, WP_PV_GRID_MAX 2 kW)<br/>on surplus &gt; 200 W, held while &ge; 0<br/><font point-size="9">make check: 384 combinations</font>>, fillcolor="#dbe8fb"];
		cforce [label=<<b>FORCE</b>: min(500 W, chg_cap)<br/>any time of day, no TOU window>, fillcolor="#eaf6e6"];
		camount [label=<<b>charge amount</b><br/>max(0, own + KP x (z2 + Bat1_eff - target))<br/>chg_ref = z2 (+ D6 share); target + EXPORT_CAP while D4 cap;<br/>&le; sum of chg_cap>, fillcolor="#eaf6e6"];
		csplit [label=<<b>alloc_levels</b> up to chg_cap<br/>stack by stack in CHARGE_PRIORITY,<br/>lead stack last>, fillcolor="#eaf6e6"];
		camount -> csplit;
	}

	subgraph cluster_dis {
		label=<<b>discharge branch</b>>; style="rounded,filled"; fillcolor="#eef7ec"; color="#5a9e4b"; fontsize=12;
		src [label=<<b>BM_SRC_RULE[src]</b><br/>STK: Bat1 signed, +trickle, idle 0<br/>else: Bat1 charge only, idle 20 W>, fillcolor="#eaf6e6"];
		d3 [label=<<b>D3</b> PROP / IDLE>, fillcolor="#dbe8fb"];
		damount [label=<<b>discharge amount</b><br/>min(PROP ? deficit : idle, W_MAX, WP_CAP)>, fillcolor="#eaf6e6"];
		dsplit [label=<<b>alloc_levels</b> up to dis_cap<br/>lead stack first, else<br/>every stack the same share>, fillcolor="#eaf6e6"];
		src -> d3 -> damount -> dsplit;
	}

	d5 [label=<<b>D5</b> PCC &gt; 20 kW for 2 min (at once &gt; 23 kW) -&gt; DO4 pulse<br/>pv_relay/DO4 (FoxESS shedding)<br/>first: R290 boost + air conditioning at &ge; 18 kW<br/>grid offline: AC-out feed &gt; 5 kW / unit for 10 s -&gt; at once>, fillcolor="#ffd09a"];
	out [label=<<b>setpoints</b> per phase -&gt; Multis (+ charge / - discharge)<br/>rule text: mode WP: SRC: split [CAP] [WPPV] [CCL / DCL / WPCAP]<br/>-&gt; state.json -&gt; victron2db.py -&gt; wagodb.pv_victron.bm_l1..3_rule (every minute)>, fillcolor="#ffffff"];

	in -> d1 -> d2;
	d1 -> wpm [style=dashed, arrowhead=none, label=" S2 kind"];
	d1 -> d6 [style=dashed, label=" kind ALL"];
	d4 -> d6 [style=dashed, color="#d9822b", label=" no cap"];
	d6 -> camount [color="#d9822b", penwidth=2, label=" + share"];
	d6 -> d2 [style=dashed, label=" surplus"];
	in -> gates;
	gates -> d2 [style=dashed, label=" SoC"];
	d2 -> lead -> mode;
	mode -> cforce [label=" FORCE"];
	mode -> camount [label=" CHARGE"];
	mode -> src [label=" DIS"];
	mode -> out [label=" 0 W rows", style=dashed];
	d4 -> d2 [color="#d9822b", label=" block"];
	in -> d4 [style=dashed];
	in -> d5 [style=dashed, color="#d9822b"];
	d1 -> src [style=dashed, label=" src, z2"];
	cforce -> out;
	csplit -> out;
	dsplit -> out;
}

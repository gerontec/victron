// batmonitor 0.50-c: charge path of one cycle as decision matrices, with the summer peak window (D4 LADESPERRE)
// that keeps the stacks free in the morning so they take the midday PV and the PCC export stays below 20 kW.
// render: dot -Tpdf charge_flow.dot -o charge_flow.pdf   (or -Tpng)
digraph charge {
	graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.35, newrank=true,
		   label="batmonitor 0.50-c: charge path (every 5 s)   |   blue = pure decision function (bits + state, enumerated by make check)   |   green = matrix / amounts   |   [CBMC] = proved for all inputs",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b><br/>PCC (+ = export), PCC 5 min mean, Sofar Bat1 W (+ = charge), Multis AC-in,<br/>outdoor temperature, BMS SoC / U / CCL, time (local, solar noon)>, fillcolor="#ffffff"];

	surplus [label=<<b>surplus</b> (chain_mode)<br/>Bat1_eff = Bat1 discharge x 1, Bat1 charge x BAT1_CHARGE_FACTOR 0.5<br/>surplus = z2 + Bat1_eff + own_charge - own_discharge<br/><font point-size="9">z2 = PCC + WP part the stacks do not cover (S2, as discharge)</font>>];

	subgraph cluster_d4 {
		label=<<b>D4 peak window as a forecast export cap</b> (0.49-c: pure function bm_d4)<br/>goal: keep the stacks free for the afternoon peaks, charge only the export above EXPORT_CAP (summer 2026: DO4 on 55 days, 11:45-16:15)>;
		style="rounded,filled"; fillcolor="#fdf0e0"; color="#d9822b"; fontsize=11;
		subgraph cluster_sky {
			label=<<b>clear-sky model</b> dc(t) (bm_logic.c calc_arrays_kt, from fox2db_logic.h / clearsky.tex)>;
			style="rounded,filled"; fillcolor="#fffaf0"; color="#b8860b"; fontsize=10;
			sky [shape=plain, label=<
				<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
				<tr><td colspan="2"><b>inputs</b></td></tr>
				<tr><td>time</td><td>unix clock (NTP, Fritzbox)</td></tr>
				<tr><td>site</td><td>LAT 47.6811 N, LON 11.5732 E (Lenggries)</td></tr>
				<tr><td>outdoor temperature</td><td>aussen/temp (MQTT, &lt; 15 min old)</td></tr>
				<tr><td colspan="2"><b>steps</b></td></tr>
				<tr><td>sun</td><td>NOAA: elevation, azimuth from time + site</td></tr>
				<tr><td>atmosphere</td><td>air mass AM = 1 / sin(elev) (&le; 37), Meinel T = 0.7^(AM^0.678)</td></tr>
				<tr><td>4 PV strings</td><td>tilt / azimuth from south / power, fitted per string (gen_pv_strings.py, 14 clear days):<br/>Sofar PV1 west 60 deg / +33 deg / 19430 W, PV2 south 68 deg / -12 deg / 7690 W<br/>FoxESS pv2 east 59 deg / -29 deg / 22036 W, pv1 west 67 deg / +32 deg / 2781 W</td></tr>
				<tr><td>horizon</td><td>trees east: below 23 deg (south-east 15 deg) only 25 % diffuse</td></tr>
				<tr><td>month</td><td>KT_MONTH empirical: Dec 0.13 ... May 0.91</td></tr>
				<tr><td>temperature</td><td>cell = outdoor + NOCT 45 x sun; -0.30 %/K above 25 deg C (0.85..1.0)</td></tr>
				<tr><td colspan="2">dc(t) = &Sigma; power x T x kt x cos(incidence) x shade x temperature factor</td></tr>
				</table>>];
		}
		model [label=<<b>forecast scan</b> (ladesperre wrapper, not a decision)<br/>now .. 21:00 in 15 min: PV = clear sky x OWM slot kt x correction,<br/>anchored to the measured Sofar PV of now (fades over 1.5 h)<br/>expected export = PV - HOUSE_EST 1000 W; peak_h, win_end_h (last export &gt; cap)>, fillcolor="#ffffff"];
		sky -> model [label=" dc(t)"];
		d4bits [shape=plain, label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td colspan="2"><b>bm_d4 bits</b></td></tr>
			<tr><td>enabled</td><td>BATMONITOR_LADESPERRE and EXPORT_CAP &gt; 0 (18000 W)</td></tr>
			<tr><td>season</td><td>May..August</td></tr>
			<tr><td>fc_cap_ahead</td><td>forecast export &gt; EXPORT_CAP before 21:00</td></tr>
			<tr><td>surplus_cap_on / hold</td><td>surplus - EXPORT_CAP &gt; 200 W / &gt; 20 W</td></tr>
			<tr><td>chg_prev</td><td>a stack charged last cycle</td></tr>
			<tr><td>new_day, pcc_peak</td><td>display: PCC &gt; 20 kW seen today</td></tr>
			</table>>];
		d4 [label=<<b>bm_d4</b>   state: peak_today (display)<br/><b>cap_active</b> = enabled and season and fc_cap_ahead<br/>charge above the cap = surplus_cap_on or (chg_prev and surplus_cap_hold)<br/><b>block</b> (wait, LADESPERRE 0 W) = cap_active and not charge above the cap<br/>cap_active -&gt; charge target PCC = +EXPORT_CAP (rule text CAP)<br/><font point-size="9">[make check: 384 combinations, 48 cap, 24 waiting; fixed point]</font>>, fillcolor="#dbe8fb"];
		note_ls [shape=note, fillcolor="#fff7d6", fontsize=9, label=<replaces 0.48-c latch / ratio / bad weather<br/>(only 12 of 4096 combinations blocked, one cloudy<br/>cycle ended the window for the day); the anchored<br/>forecast follows clouds within one cycle>];
		model -> d4bits -> d4;
		d4 -> note_ls [style=dotted, arrowhead=none];
	}

	d2 [label=<<b>D2</b> bm_d2 per stack   state: prot, force, chg_prev<br/>charge_mode: surplus &gt; 200 W on, held while &gt; 20 W<br/>first match: BMS_MISSING &gt; FORCE &gt; STALE &gt; LADESPERRE (charge_mode and block) &gt;<br/>CHARGE (SoC &lt; 100) / FULL &gt; PROT &gt; CHARGING &gt; DIS<br/><font point-size="9">[make check, CBMC h_d2_bits]</font>>, fillcolor="#dbe8fb"];

	subgraph cluster_mode {
		label=<<b>mode matrix</b> BM_MODE_RULE[mode] (0.48-c): what each mode means for the setpoint>;
		style="rounded,filled"; fillcolor="#eaf6e6"; color="#5a9e4b"; fontsize=11;
		mrule [shape=plain, label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td><b>mode</b></td><td><b>action</b></td><td><b>capped</b></td><td><b>rule text</b></td></tr>
			<tr><td>BMS_MISSING</td><td>0 W</td><td>-</td><td>NAME</td></tr>
			<tr><td bgcolor="#cfe8c6">FORCE</td><td bgcolor="#cfe8c6">FORCE_CHARGE_W 500</td><td bgcolor="#cfe8c6"><b>1</b> (0.48-c)</td><td bgcolor="#cfe8c6">FORCE(soc %)</td></tr>
			<tr><td>STALE</td><td>0 W</td><td>-</td><td>NAME</td></tr>
			<tr><td bgcolor="#ffd09a">LADESPERRE</td><td bgcolor="#ffd09a">0 W</td><td bgcolor="#ffd09a">-</td><td bgcolor="#ffd09a">LADESPERRE(peak h)</td></tr>
			<tr><td bgcolor="#cfe8c6">CHARGE</td><td bgcolor="#cfe8c6">charge amount</td><td bgcolor="#cfe8c6">1</td><td bgcolor="#cfe8c6">CHARGE WP: SRC:</td></tr>
			<tr><td>FULL</td><td>0 W</td><td>-</td><td>NAME</td></tr>
			<tr><td>PROT</td><td>0 W</td><td>-</td><td>PROT(soc %)</td></tr>
			<tr><td>CHARGING</td><td>0 W</td><td>-</td><td>CHARGING(BMS W)</td></tr>
			<tr><td>DIS</td><td>discharge amount</td><td>1</td><td>(S4: PROP / IDLE)</td></tr>
			</table>>];
		force [label=<<b>FORCE</b>: min(FORCE_CHARGE_W, chg_cap) per phase<br/>from the grid, obeys the BMS CCL (was: 500 W even at CCL 0)>, fillcolor="#ffffff"];
		amount [label=<<b>charge amount</b> (chain_charge, whole watts since 0.48-c)<br/>want = max(0, own_charge + KP_PM 1010 x (z2 + Bat1_eff - target) / 1000)<br/>target = SOYO_TARGET, + EXPORT_CAP while D4 cap_active (0.49-c)<br/>at most the sum of chg_cap over the charging phases<br/><font point-size="9">[CBMC h_charge]</font>>, fillcolor="#ffffff"];
		caps [label=<<b>chg_cap</b> per phase (one per stack)<br/>min(CHARGER_A 70 A x U / 0.93, CHARGE_MAX_PHASE 4900, BMS CCL)<br/>~4.0-4.2 kW per phase -&gt; ~12 kW for the three Multis>, fillcolor="#ffffff"];
		alloc [label=<<b>alloc_levels</b> (0.48-c: one split core for charge and discharge)<br/>charge: one level per stack in CHARGE_PRIORITY order (Stack1, Stack2), the lead stack last,<br/>each up to min(chg_cap, CHARGER_CAP_PHASE); water filling within a level;<br/>only what the caps cut goes on; a rest up to CHARGE_MAX_PHASE on all charging phases<br/><font point-size="9">[CBMC h_charge without bank assumption, h_alloc_discharge]</font>>, fillcolor="#ffffff"];
		mrule -> force [label=" FORCE"];
		mrule -> amount [label=" CHARGE"];
		caps -> amount [style=dashed];
		caps -> alloc [style=dashed];
		caps -> force [style=dashed];
		amount -> alloc;
	}

	subgraph cluster_prio {
		label=<<b>export above 18 kW: who takes it</b> (user 2026-10-10: boost and air conditioning before DO4)>;
		style="rounded,filled"; fillcolor="#fff0f0"; color="#c0392b"; fontsize=10;
		prio [shape=plain, label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td><b>order</b></td><td><b>who</b></td><td><b>when</b></td></tr>
			<tr><td>1</td><td>stacks (D4 export cap, May-Aug)</td><td>every 5 s: the export above 18 kW, up to ~12 kW charger</td></tr>
			<tr><td>2</td><td>R290 boost (r290_boost.py, .218)</td><td>cron 1/min: PCC &ge; 18 kW -&gt; hot water 55 deg C</td></tr>
			<tr><td>2</td><td>attic air conditioning (hantech.py, .218)</td><td>cron 1/min: PCC &ge; 18 kW -&gt; on</td></tr>
			<tr><td>3</td><td bgcolor="#ffd09a">D5 DO4 pulse -&gt; pv_relay/DO4 (FoxESS shedding)</td><td bgcolor="#ffd09a">PCC &gt; 20 kW for 2 min (DO4_GRACE_S), at once &gt; 23 kW (DO4_HARD_W);<br/>"1", 3 s later "0"; at most every 5 min; batmonitor/do4_last retained</td></tr>
			</table>>];
	}

	out [label=<<b>setpoints</b> per phase (+ = charge) -&gt; Multis<br/>rule text: CHARGE WP:.. SRC:.. BAL/EQ [CCL] | LADESPERRE(h) | FULL | FORCE(soc)>, fillcolor="#ffffff"];

	timeline [shape=plain, label=<
		<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff">
		<tr><td colspan="4"><b>clear summer day: how the export cap keeps the PCC below 20 kW</b></td></tr>
		<tr><td><b>time</b></td><td><b>PV / PCC</b></td><td><b>batmonitor</b></td><td><b>stacks</b></td></tr>
		<tr><td>morning</td><td>export below the cap</td><td bgcolor="#ffd09a">LADESPERRE (wait)</td><td>0 W, stay free</td></tr>
		<tr><td>midday .. afternoon</td><td>export above 18 kW</td><td>CHARGE CAP: PCC held at 18 kW</td><td>take the export above the cap</td></tr>
		<tr><td>stacks at their charger limit</td><td>export still above 18 kW</td><td>R290 boost + air conditioning; DO4 after 2 min &gt; 20 kW</td><td>full charge power</td></tr>
		<tr><td>after the forecast window</td><td>export below the cap again</td><td>CHARGE (no cap)</td><td>fill up to 100 %</td></tr>
		<tr><td>cloudy forecast</td><td>no export &gt; cap expected</td><td>no cap</td><td>charge at once</td></tr>
		<tr><td>clouds come up</td><td>measured PV low</td><td>anchor drops -&gt; cap ends</td><td>charge at once</td></tr>
		</table>>];

	in -> surplus -> d2;
	in -> model;
	in -> prio [style=dashed, label=" PCC", color="#c0392b"];
	d4 -> d2 [color="#d9822b", penwidth=2, label=" block"];
	d2 -> mrule [label=" mode per stack"];
	force -> out;
	alloc -> out;
	mrule -> out [label=" 0 W rows", style=dashed];
	out -> timeline [style=invis];
}

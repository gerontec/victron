// batmonitor 0.74: decision flow of one cycle (bm_step), the discharge path highlighted.
// render: python3 docs/gen_docs.py
digraph batmonitor {
	graph [rankdir=TB, compound=true, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.35, newrank=true,
		   label="batmonitor 0.74: discharge path of one cycle (bm_step, every 5 s)   |   max persistent decision states 12288 = D1 2 x D2 128 x lead 3 x D3 2 x D4 2 x D7 4   |   blue = decision (c/bm_tables.h, make check)   |   green = discharge matrix   |   [CBMC] = proved for all inputs",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b> (chain_inputs)<br/>PCC (live), Sofar Bat1 W + SoC, heat pump W (SDM72D), PV,<br/>BMS SoC / U / CCL / DCL / cells, AC-in / AC-out per phase<br/>-&gt; stale, wp_on (fresh and &ge; WP_ON_TH 300 W), night (PV &lt; NIGHT_PV_TH 100 W), winter (Oct..Mar)>, fillcolor="#ffffff"];

	d7 [label=<<b>D7</b> house on AC-out1 (0.69-c)   state: house_on, under timer<br/>HOUSE_ACOUT 0 off / 1 on / 2 auto (on &gt; 99 W, off after 60 s &lt; 30 W)<br/>on: no source row, no night floor, no heat pump cap (src text Z1 / Z2)<br/><font point-size="9">[make check: 54 combinations, 29 on, 4 states reachable]   Lenggries env: HOUSE_ACOUT=0</font>>, fillcolor="#dbe8fb"];

	d1 [label=<<b>D1</b> bm_d1   state: bat1_first<br/>Sofar first: Bat1 SoC &gt; BAT1_SOC_MIN (on again from +2 %) and heat pump on<br/>winter heat pump rule: winter and heat pump on -&gt; Bat1 discharging: 0 W, else WP_WINTER_W<br/><font point-size="9">[make check: 128 cells, 14 outcomes; details wp_matrix]</font>>, fillcolor="#dbe8fb"];

	src [label=<<b>S3 source</b><br/>day -&gt; <b>DAY</b><br/>night + Sofar first -&gt; <b>B1</b><br/>winter night + heat pump on -&gt; <b>WPG</b> (no night floor)<br/>else night -&gt; <b>STK</b> (night floor)>, fillcolor="#dbe8fb"];

	share [label=<<b>house</b> = PCC + own charge (the real PCC, target 0 W)<br/>dis_max = W_MAX, or the winter heat pump cap (rule text WPMAX(W))>];

	gates [label=<<b>S0 gates</b> per bank (chain_gates)<br/>SoC from the BMS; caps per phase, one per bank:<br/>chg_cap = min(charger x U, BMS CCL, top hold)   dis_cap = min(DISCHARGE_MAX_PHASE, BMS DCL)>];

	d2 [label=<<b>D2</b> bm_d2 per bank   state: prot, force, low, chg_prev<br/>first match: BMS_MISSING &gt; FORCE (force or low) &gt; STALE &gt; LADESPERRE &gt;<br/>CHARGE / FULL &gt; HOLD &gt; PROT &gt; CHARGING &gt; <b>DIS</b><br/><b>LOW</b>: on at DCL &lt; DCL_FORCE_A 1 A or lowest cell &lt; CELL_FORCE_V,<br/>off when DCL is back, the cell &ge; CELL_FORCE_RELEASE_V and SoC &ge; SOC_MIN_RELEASE;<br/>LOW -&gt; FORCE (charge, no discharge); Lenggries env: CELL_FORCE_V 3.05 V / release 3.20 V<br/>HOLD: the force_full_from_pv stack never discharges<br/><font point-size="9">make check: 64512 combinations per stack -&gt; DIS 360 of them</font><br/><font point-size="9">[CBMC h_d2_bits; threshold order needed: h_d2_bits_any_order]</font>>, fillcolor="#dbe8fb"];

	lead [label=<<b>D-lead</b> bm_dlead   state: lead<br/>|SoC1 - SoC2| &gt; SOC_BALANCE_ON -&gt; the stack ahead leads<br/>&lt; SOC_BALANCE_OFF -&gt; no lead>, fillcolor="#dbe8fb"];

	modesplit [label="mode per phase", shape=diamond, fillcolor="#ffffff"];
	other [label=<BMS_MISSING / FORCE / STALE / LADESPERRE /<br/>FULL / HOLD / PROT / CHARGING<br/>-&gt; fixed setpoint (0, force charge incl. LOW, ...)>];

	subgraph cluster_dis {
		label=<<b>discharge matrix</b> (0.45-c, whole watts)>; style="rounded,filled"; fillcolor="#eaf6e6"; color="#5a9e4b"; fontsize=11;
		rule [shape=plain, fillcolor="#ffffff", label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td colspan="5"><b>BM_SRC_RULE[src]</b></td></tr>
			<tr><td><b>SRC</b></td><td>b1_signed</td><td>trickle</td><td>idle_w</td><td>prop_hold</td></tr>
			<tr><td>DAY</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			<tr><td>B1</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			<tr><td bgcolor="#cfe8c6">STK</td><td bgcolor="#cfe8c6">1</td><td bgcolor="#cfe8c6">1</td><td bgcolor="#cfe8c6">0</td><td bgcolor="#cfe8c6">1</td></tr>
			<tr><td bgcolor="#fde9c8">WPG</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			</table>>];
		deficit [label=<<b>deficit</b> (int W)<br/>b1 = b1_signed ? Bat1 : max(Bat1 charge, 0)<br/>target = SOYO_TARGET + (trickle ? SOFAR_TRICKLE : 0)<br/>deficit = own_discharge - b1 - KP_PM x (house - target) / 1000>, fillcolor="#ffffff"];
		d3 [label=<<b>D3</b> bm_d3   state: prop_prev<br/>PROP = import (&lt; -100 W) or<br/>((prop_prev or prop_hold) and deficit &gt; 20 W)>, fillcolor="#dbe8fb"];
		amount [label=<<b>dis_amount</b>: w = min(PROP ? max(deficit, 0) : idle_w, dis_max)<br/><font point-size="9">[CBMC h_dis_amount]</font>>, fillcolor="#ffffff"];
		house [label=<<b>D7 on</b> (no PROP / IDLE state)<br/>winter: w = AC-out1 load (Z2 near 0) -&gt; <b>HOUSE</b><br/>summer: w = max(PCC deficit, AC-out1 load) -&gt; <b>PROP</b> / <b>HOUSE</b><br/>winter export cap (0.74-c): w &le; what keeps the export at CHARGE_RESERVE -&gt; <b>EXPCAP</b><br/>at most W_MAX>, fillcolor="#ffffff"];
		alloc [label=<<b>alloc_discharge</b> on <b>alloc_levels</b> (one split core for charge and discharge)<br/>always all discharging phases (single-unit D6 / 1PH removed in 0.70-c)<br/>lead: level 0 = lead stack (BAL), level 1 = only what its caps cut (SPILL / WAIT)<br/>no lead: one level, every stack the same share (EQ); water filling up to dis_cap<br/><font point-size="9">[CBMC h_alloc_discharge: within caps, total &le; w, lead first, equal per stack]</font>>, fillcolor="#ffffff"];
		rule -> deficit -> d3 -> amount -> alloc;
		deficit -> house [style=dashed, label=" D7 on"];
		house -> alloc;
	}

	chg [label=<<b>charge</b> (chain_charge)<br/>want = max(0, own_charge + KP x (surplus - CHARGE_RESERVE))<br/>alloc_charge: CHARGE_PRIORITY, lead stack last, up to chg_cap<br/><font point-size="9">[CBMC h_charge]</font>>];

	out [label=<<b>setpoints</b> per phase -&gt; Multis (ESS AcPowerSetpoint)<br/>rule text: &lt;PROP / IDLE / HOUSE / EXPCAP&gt; SRC:&lt;DAY / B1 / STK / WPG / Z1 / Z2&gt; &lt;EQ / BAL / SPILL / WAIT&gt; [WPMAX(W)] [DCL]<br/><font point-size="9">[CBMC h_discharge: whole discharge path]</font>>, fillcolor="#ffffff"];
	pi [label="PI prototype (shadow, not armed)", fillcolor="#eeeeee", fontcolor="#777777", style="rounded,filled,dashed"];

	in -> d7 -> d1;
	d1 -> src [label=" src"];
	d1 -> share [label=" WPMAX"];
	in -> gates;
	share -> d2 [label=" surplus"];
	gates -> d2;
	d2 -> lead;
	lead -> modesplit;
	modesplit -> rule [label=" DIS", color="#5a9e4b", fontcolor="#3c7a30"];
	modesplit -> chg [label=" CHARGE"];
	modesplit -> other [label=" else"];
	src -> rule [color="#5a9e4b", style=dashed, label=" row"];
	share -> deficit [style=dashed, label=" house"];
	gates -> alloc [style=dashed, label=" dis_cap"];
	lead -> alloc [style=dashed, label=" lead"];
	alloc -> out;
	chg -> out;
	other -> out;
	out -> pi [style=dashed, arrowhead=none];

	{rank=same; src; share;}
}

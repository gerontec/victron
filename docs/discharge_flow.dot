// batmonitor 0.45-c: decision flow of one cycle (bm_step), the discharge matrix highlighted.
// render: dot -Tpdf discharge_flow.dot -o discharge_flow.pdf   (or -Tpng)
digraph batmonitor {
	graph [rankdir=TB, compound=true, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.35, newrank=true,
		   label="batmonitor 0.65-c: one cycle (bm_step, every 5 s)   |   max persistent decision states 36864 (0.62-c: 3072) = D1 2 x D2 128 x lead 3 x D3 2 x D4 2 x D6 4 x unit 3   |   blue = pure decision function (bits + state, enumerated by make check)   |   green = discharge matrix   |   [CBMC] = proved for all inputs",
		   labelloc=t];
	node [shape=box, style="rounded,filled", fillcolor="#f4f4f4", fontname="Helvetica", fontsize=10];
	edge [fontname="Helvetica", fontsize=9];

	in [label=<<b>inputs</b> (chain_inputs)<br/>PCC, Sofar Bat1 W + SoC, em0 WP W, R290 Hz, PV,<br/>BMS SoC / U / CCL / DCL / lowest cell (0.52-c)<br/>-&gt; stale, wp_on (em0 fresh and &ge; WP_ON_TH), night (PV &lt; NIGHT_PV_TH)>, fillcolor="#ffffff"];

	d1 [label=<<b>D1</b> bm_d1   state: bat1_first, wp_low<br/>B1FIRST: Bat1 SoC &gt; BAT1_SOC_MIN (on from +2 %) and WP on<br/>WPLOW: lowest stack &lt; WP_SOC_MIN 21 % (back &ge; 23 %)<br/><font point-size="9">[make check: 192 combinations]</font>>, fillcolor="#dbe8fb"];

	src [label=<<b>S3 source</b> (0.59-c: no season)<br/>day -&gt; <b>DAY</b><br/>night + B1FIRST -&gt; <b>B1</b><br/>night, WPLOW + WP on -&gt; <b>WPG</b> (grid pays the WP)<br/>else night -&gt; <b>STK</b> (night floor)>, fillcolor="#dbe8fb"];

	share [label=<<b>house</b> = PCC + own charge (+ WP while WPLOW)<br/>0.59-c: the real PCC, target 0 W; the heat pump is house load<br/>(removed: Z2 winter rule, 1900 W transition cap, forecast rule, WPPV, WP_CAP)>];

	gates [label=<<b>S0 gates</b> per bank (chain_gates)<br/>SoC from the BMS; caps per phase, one per bank:<br/>chg_cap = min(charger x U, BMS CCL)   dis_cap = min(DISCHARGE_MAX_PHASE, BMS DCL)>];

	d2 [label=<<b>D2</b> bm_d2 per bank   state: prot, force, low, chg_prev<br/>first match: BMS_MISSING &gt; FORCE (force or low) &gt; STALE &gt; LADESPERRE &gt;<br/>CHARGE / FULL &gt; PROT &gt; CHARGING &gt; <b>DIS</b><br/><b>LOW</b> (0.52-c, state low): on at DCL &lt; DCL_FORCE_A 1 A or lowest cell &lt; CELL_FORCE_V 3.00 V,<br/>off when DCL is back, the cell &ge; CELL_FORCE_RELEASE_V 3.25 V and (0.55-c) SoC &ge; SOC_MIN_RELEASE;<br/>LOW -&gt; FORCE (charge, no discharge); Lenggries env: CELL_FORCE_V 3.05 V<br/><font point-size="9">make check: 16128 combinations per stack (84 bit sets x 12 global x 16 states) -&gt; mode:<br/>BMS_MISSING 8064 · FORCE 5760 · STALE 1152 · LADESPERRE 288 · CHARGE 216 ·<br/>PROT 216 · CHARGING 180 · DIS 180 · FULL 72</font><br/><font point-size="9">[CBMC h_d2_bits; threshold order needed: h_d2_bits_any_order]</font>>, fillcolor="#dbe8fb"];

	lead [label=<<b>D-lead</b> bm_dlead   state: lead<br/>|SoC1 - SoC2| &gt; SOC_BALANCE_ON -&gt; the stack ahead leads<br/>&lt; SOC_BALANCE_OFF -&gt; no lead>, fillcolor="#dbe8fb"];

	modesplit [label="mode per phase", shape=diamond, fillcolor="#ffffff"];
	other [label=<BMS_MISSING / FORCE / STALE / LADESPERRE /<br/>FULL / PROT / CHARGING<br/>-&gt; fixed setpoint (0, force charge incl. LOW, ...)>];

	subgraph cluster_dis {
		label=<<b>discharge matrix</b> (0.45-c, whole watts)>; style="rounded,filled"; fillcolor="#eaf6e6"; color="#5a9e4b"; fontsize=11;
		rule [shape=plain, fillcolor="#ffffff", label=<
			<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
			<tr><td colspan="5"><b>BM_SRC_RULE[src]</b></td></tr>
			<tr><td><b>SRC</b></td><td>b1_signed</td><td>trickle</td><td>idle_w</td><td>prop_hold</td></tr>
			<tr><td>DAY</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			<tr><td>B1</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			<tr><td bgcolor="#cfe8c6">STK</td><td bgcolor="#cfe8c6">1</td><td bgcolor="#cfe8c6">1</td><td bgcolor="#cfe8c6">0</td><td bgcolor="#cfe8c6">1</td></tr>
			<tr><td bgcolor="#fde9c8">WPG</td><td>0</td><td>0</td><td>20</td><td>0</td></tr>
			</table>>];
		deficit [label=<<b>deficit</b> (int W)<br/>b1 = b1_signed ? Bat1 : max(Bat1 charge, 0)<br/>target = SOYO_TARGET + (trickle ? SOFAR_TRICKLE : 0)<br/>deficit = own_discharge - b1 - KP_PM x (house - target) / 1000>, fillcolor="#ffffff"];
		d3 [label=<<b>D3</b> bm_d3   state: prop_prev<br/>PROP = import (&lt; -100 W) or<br/>((prop_prev or prop_hold) and deficit &gt; 20 W)>, fillcolor="#dbe8fb"];
		amount [label=<<b>dis_amount</b>: w = min(PROP ? max(deficit, 0) : idle_w, W_MAX)<br/><font point-size="9">[CBMC h_dis_amount]</font>>, fillcolor="#ffffff"];
		alloc [label=<<b>alloc_discharge</b> on <b>alloc_levels</b> (0.48-c: one split core for charge and discharge)<br/>lead: level 0 = lead stack (BAL), level 1 = only what its caps cut (SPILL / WAIT)<br/>no lead: one level, every stack the same share (EQ)<br/>within a level: water filling up to dis_cap<br/><font point-size="9">[CBMC h_alloc_discharge: within caps, total &le; w, lead first, equal per stack]</font>>, fillcolor="#ffffff"];
		subgraph cluster_one {
			label=<<b>D6</b> bm_d6 + S5a single_phase (0.63-c / 0.65-c): one MultiPlus while the grid is there   <font point-size="9">[make check: 96 combinations (5 bits x 4 states), 14 one unit, 4 states reachable]</font>>; style="rounded,filled"; fillcolor="#dbe8fb"; color="#c99a2e"; fontsize=10;
			why1 [shape=plain, label=<<font point-size="9">why: a MP2 loses ~30-40 W fixed + poor efficiency at low power; pv_victron 18.-26.10.2026:<br/>discharge &lt; 2 kW total lost 14 %, 2-8 kW 4-5 %, &gt; 80 % of the minutes &lt; 2 kW.<br/>Grid there: the meter nets the phases -&gt; one unit feeds, the others STBY (unbalanced on purpose).<br/>Off-grid (emergency power): every phase carries its own load -&gt; all units feed synchronously.</font>>];
			sm [shape=plain, label=<
				<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
				<tr><td colspan="5"><b>state</b> single_all, single_over_since   (W = SINGLE_DIS_W 3000, H = SINGLE_DIS_HYST_W 500, T = SINGLE_DIS_UP_S 60 s)</td></tr>
				<tr><td><b>grid_ok</b></td><td><b>W &gt; 0</b></td><td><b>amount w</b></td><td><b>next state</b></td><td><b>split</b></td></tr>
				<tr><td>0</td><td>-</td><td>-</td><td>unchanged</td><td bgcolor="#cfe8c6">ALL (synchronous, off-grid)</td></tr>
				<tr><td>1</td><td>0</td><td>-</td><td>unchanged</td><td bgcolor="#cfe8c6">ALL (= 0.62-c)</td></tr>
				<tr><td>1</td><td>1</td><td>w &lt; W - H</td><td>ONE, over 0</td><td bgcolor="#fde9c8">1PH</td></tr>
				<tr><td>1</td><td>1</td><td>W - H &le; w &le; W</td><td>kept, over 0</td><td>1PH if ONE, ALL if ALL</td></tr>
				<tr><td>1</td><td>1</td><td>w &gt; W, &lt; T s</td><td>kept, over runs</td><td bgcolor="#fde9c8">1PH if ONE (up to dis_cap)</td></tr>
				<tr><td>1</td><td>1</td><td>w &gt; W, &ge; T s</td><td>ALL</td><td bgcolor="#cfe8c6">ALL</td></tr>
				<tr><td colspan="4">1PH but w &gt; dis_cap of that phase (3800 W / BMS DCL)</td><td bgcolor="#cfe8c6">ALL this cycle</td></tr>
				</table>>];
			states [shape=plain, label=<
				<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
				<tr><td bgcolor="#fde9c8"><b>ONE</b><br/>single_all 0<br/>over 0</td><td>-- w &gt; W --&gt;<br/>&lt;-- w &le; W --</td><td bgcolor="#fde9c8"><b>OVER</b><br/>single_all 0<br/>over_since set</td><td>-- T s --&gt;</td><td bgcolor="#cfe8c6"><b>ALL</b><br/>single_all 1</td></tr>
				<tr><td colspan="5">ALL -- w &lt; W - H --&gt; ONE     (ALL with W - H &le; w stays ALL; ALL + over while w &gt; W)</td></tr>
				<tr><td colspan="5"><font point-size="9">invariants (make check): one unit only with grid + W on; off-grid all phases, state untouched;<br/>all phases only after T s above W; back only below W - H; fixed point after one step (no flapping)</font></td></tr>
				</table>>];
			pick [label=<<b>which unit</b> (state single_ph)<br/>lead stack (D-lead) -&gt; its first phase<br/>else the kept one while its SoC &ge; other - SOC_BALANCE_OFF<br/>else the fuller stack (equal SoC: Stack1)<br/>Stack1 -&gt; L1, Stack2 -&gt; L2 (first discharging phase)<br/>rule tags: <b>1PH</b> (feeds w) / <b>STBY</b> (0 W)>, fillcolor="#ffffff"];
			why1 -> sm [style=invis];
			sm -> states -> pick [style=invis];
		}
		rule -> deficit -> d3 -> amount;
		amount -> sm [lhead=cluster_one];
		pick -> alloc [label=" ALL"];
	}

	chg [label=<<b>charge</b> (chain_charge)<br/>want = max(0, own_charge + KP x surplus)<br/>alloc_charge: CHARGE_PRIORITY, lead stack last, up to chg_cap<br/><font point-size="9">[CBMC h_charge]</font>>];

	out [label=<<b>setpoints</b> per phase -&gt; Multis (ESS AcPowerSetpoint)<br/>rule text: &lt;mode&gt; SRC:&lt;src&gt; &lt;split: EQ/BAL/SPILL/WAIT/1PH/STBY&gt; [CCL/DCL] [WPLOW]<br/><font point-size="9">[CBMC h_discharge: whole discharge path]</font>>, fillcolor="#ffffff"];
	pi [label="PI prototype (shadow, not armed)", fillcolor="#eeeeee", fontcolor="#777777", style="rounded,filled,dashed"];

	in -> d1;
	d1 -> src [label=" src"];
	d1 -> share [label=" WPLOW"];
	in -> gates;
	share -> d2 [label=" surplus"];
	gates -> d2;
	d2 -> lead;
	lead -> modesplit;
	modesplit -> rule [label=" DIS", color="#5a9e4b", fontcolor="#3c7a30"];
	modesplit -> chg [label=" CHARGE"];
	modesplit -> other [label=" else"];
	src -> rule [color="#5a9e4b", style=dashed, label=" row"];
	share -> deficit [style=dashed, label=" house"];
	gates -> alloc [style=dashed, label=" dis_cap"];
	lead -> alloc [style=dashed, label=" lead"];
	alloc -> out;
	pick -> out [label=" 1PH / STBY", color="#c99a2e", fontcolor="#8a6716"];
	in -> sm [style=dashed, label=" grid_ok (vebus ActiveIn)"];
	chg -> out;
	other -> out;
	out -> pi [style=dashed, arrowhead=none];

	{rank=same; src; share;}
}
